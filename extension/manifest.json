{
  "manifest_version": 3,
  "name": "클린 영상 다운로더",
  "version": "2.4.0",
  "description": "웹페이지의 영상·오디오·직접 미디어 링크를 Chrome에서 바로 저장합니다.",
  "homepage_url": "https://salkka-dev.github.io/clean-video-downloader/",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "현재 페이지의 미디어 다운로드"
  },
  "background": {
    "service_worker": "background.js"
  }
}
