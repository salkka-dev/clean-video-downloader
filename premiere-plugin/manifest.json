{
  "manifestVersion": 5,
  "id": "kr.cleanvideodownloader.premiere",
  "name": "클린 영상 다운로더",
  "shortname": "CleanVideo",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": ["cleanvideo"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cleanVideoDownloaderPanel",
      "label": { "default": "클린 영상 다운로더" },
      "minimumSize": { "width": 280, "height": 420 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 340, "height": 620 },
      "preferredFloatingSize": { "width": 380, "height": 680 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
