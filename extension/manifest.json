{
  "manifest_version": 3,
  "name": "클린 영상 다운로더",
  "version": "2.5.0",
  "description": "앱 없이 웹 영상·오디오를 저장하고 현재 영상 프레임을 복사하거나 PNG로 저장합니다.",
  "homepage_url": "https://salkka-dev.github.io/clean-video-downloader/",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "downloads",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "클린 영상 다운로더",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
